<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the Vintage Story 1.22 runtime (.NET 10), which you already have installed. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Layout</AssemblyName>
    <RootNamespace>Layout</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- This is a compile-check only: we are not packaging a runnable mod yet. -->
  </PropertyGroup>

  <!-- =============================================================== -->
  <!--  Path to the Vintage Story INSTALL folder - the folder that     -->
  <!--  contains VintagestoryAPI.dll (and a Lib\ subfolder).           -->
  <!--                                                                 -->
  <!--  Resolved automatically, in this order:                         -->
  <!--    1. -p:VintagestoryDir=... passed on the command line         -->
  <!--    2. the VINTAGE_STORY environment variable                    -->
  <!--    3. the platform's default install location                   -->
  <!--                                                                 -->
  <!--  So an ordinary install needs NO edit on any platform. If the   -->
  <!--  game lives somewhere non-standard, set VINTAGE_STORY or pass   -->
  <!--  the property - do not hard-code a path here, since this file   -->
  <!--  is published.                                                  -->
  <!--                                                                 -->
  <!--  NOTE: this is the INSTALL folder (game .exe + .dll files),     -->
  <!--  NOT the data folder (which is ...\VintagestoryData and holds   -->
  <!--  saves/mods).                                                   -->
  <!-- =============================================================== -->
  <PropertyGroup>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(OS)' == 'Windows_NT'">$(APPDATA)\Vintagestory</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == ''">$(HOME)/.local/share/vintagestory</VintagestoryDir>
  </PropertyGroup>

  <!-- A clear failure beats five confusing "missing reference" errors. -->
  <Target Name="VerifyVintagestoryDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(VintagestoryDir)\VintagestoryAPI.dll')"
           Text="Could not find VintagestoryAPI.dll under '$(VintagestoryDir)'. Set the VINTAGE_STORY environment variable to your Vintage Story install folder, or build with -p:VintagestoryDir=&quot;path\to\Vintagestory&quot;." />
  </Target>

  <ItemGroup>
    <!-- The Vintage Story API: MathTools (Vec3d), Server (ICoreServerAPI), etc. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintagestoryDir)\VintagestoryAPI.dll</HintPath>
      <!-- 'false' = reference the game's DLL in place; do not copy it into our output. -->
      <Private>false</Private>
    </Reference>

    <!-- Newtonsoft.Json: used by GuideManager to serialize guide data for save/load.   -->
    <!-- Vintage Story ships this in its Lib\ subfolder. If the build reports it cannot -->
    <!-- find this file, check whether your install keeps Newtonsoft.Json.dll directly  -->
    <!-- in the install root instead, and drop "\Lib" from the path below.              -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintagestoryDir)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- protobuf-net: used by the Network layer (Module 4) to serialize packets, exactly as     -->
    <!-- Vintage Story serializes its own network messages. It ships in the game's Lib\ subfolder -->
    <!-- alongside Newtonsoft.Json. If the build reports it cannot find this file, check whether   -->
    <!-- your install keeps protobuf-net.dll directly in the install root instead, and if so drop  -->
    <!-- "\Lib" from the HintPath below.                                                           -->
    <Reference Include="protobuf-net">
      <HintPath>$(VintagestoryDir)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- cairo-sharp: the GUI's 2D vector drawing (Cairo.Context), used by LayoutToolIcons to draw the -->
    <!-- shape/toggle glyphs. Ships in the game's Lib\ subfolder alongside Newtonsoft/protobuf.        -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VintagestoryDir)\Lib\cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- VSSurvivalMod: game-content types the chalk-fill rendering hooks into — IContainedMeshSource, -->
    <!-- so ground-stored kits show the right fill-state mesh. Ships in the game's Mods\ subfolder.     -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintagestoryDir)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
